{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm test:int *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm test:visual *)",
      "Bash(pnpm build)",
      "Bash(pnpm analyze)",
      "Bash(pnpm lhci)",
      "Bash(pnpm db:seed *)",
      "Bash(pnpm prisma generate)",
      "Bash(pnpm prisma validate)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm db:status)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm test:int)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin master)",
      "Bash(pnpm prisma migrate reset *)",
      "Bash(pnpm db:deploy *)",
      "Edit(./prisma/migrations/**)",
      "Bash(pnpm db:reset:test*)",
      "Bash(node scripts/db-reset-test.mjs*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/format.mjs"
          }
        ]
      }
    ]
  }
}
