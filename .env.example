# Plantilla de variables de entorno. Copia este archivo a .env.local (desarrollo) o a
# D:\bolik\config\production.env (servidor) y escribe ahí los valores reales.
# Este archivo se sube a un repo PÚBLICO: aquí solo van marcadores, nunca credenciales.
# Las del servidor se validan al arrancar (src/env.schema.ts); una variable vacía cuenta como no definida.
# Un "$" en un valor se expande como variable: escríbelo como "\$".

# ── Sitio
APP_ENV=development                     # development | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # sin barra final; https fuera de desarrollo
NEXT_PUBLIC_GA_ID=                      # G-XXXXXXX (solo producción; pública, no se valida)
NEXT_PUBLIC_CLARITY_ID=                 # solo producción (pública, no se valida)

# ── Base de datos (SQL Server): BD propia de la web y login con permisos solo sobre ella.
# Nunca el usuario sa ni las bases de SAP / SMART-K66. Si la contraseña lleva ; = { o },
# escríbela entre llaves: password={mi;clave}. Instancia con nombre: SERVIDOR\INSTANCIA o su puerto.
DATABASE_URL="sqlserver://SERVIDOR:1433;database=BolikDigital_Dev;user=USUARIO;password=CONTRASENA;encrypt=true;trustServerCertificate=true"
# Solo para el despliegue (usuario con permisos DDL; la usan los scripts, no se valida al arrancar)
MIGRATE_DATABASE_URL=

# ── Sesión del admin (iron-session). En staging/producción: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-32-caracteres-o-mas-aleatorios
# Solo para pnpm db:seed (no se validan al arrancar)
SEED_ADMIN_EMAIL=admin@bolik66.com
SEED_ADMIN_PASSWORD=

# ── ERP (SMART-K66). noop = la web funciona sin ERP (cotizaciones solo en BD + correo)
ERP_MODE=noop                           # noop | smartk66
ERP_BASE_URL=
ERP_API_KEY=

# ── Correo
SMTP_MODE=file                          # file (escribe .eml en tmp/mails) | smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bolik <web@bolik66.com>"
MAIL_SALES_TO=ventas@bolik66.com
MAIL_SCHOOLS_TO=
MAIL_DISTRIBUTORS_TO=

# ── Medios
MEDIA_DIR=./.media                      # en servidor: D:\bolik\media
MEDIA_PUBLIC_PATH=/media

# ── SEO / IA
INDEXNOW_KEY=                           # 32 caracteres hex; vacío = no se envía

# ── Seguridad
CSP_ENFORCE=false                       # true cuando la CSP esté validada en staging (BD-142); se fija en el build

# ── Solo CI: omite la validación de variables (build sin secretos). Se ignora en staging y producción.
# SKIP_ENV_VALIDATION=true
