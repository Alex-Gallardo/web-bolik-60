# Copia este archivo a .env.local (desarrollo) o a D:\bolik\config\production.env (servidor).
# Todas se validan en src/env.ts. Nunca subas valores reales a git.

# ── Sitio
APP_ENV=development                     # development | staging | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=                      # G-XXXXXXX (solo producción)
NEXT_PUBLIC_CLARITY_ID=                 # solo producción

# ── Base de datos (SQL Server)
DATABASE_URL="sqlserver://HOST:1433;database=BolikDigital_Dev;user=USUARIO;password=CONTRASENA;encrypt=true;trustServerCertificate=true"
# Solo para el despliegue (usuario con permisos DDL)
MIGRATE_DATABASE_URL=

# ── Sesión del admin (iron-session)
SESSION_SECRET=cambia-esto-por-32-caracteres-o-mas-aleatorios   # openssl rand -base64 32
SEED_ADMIN_EMAIL=admin@bolik66.com
SEED_ADMIN_PASSWORD=

# ── ERP (SMART-K66)
ERP_MODE=noop                           # noop | smartk66
ERP_BASE_URL=
ERP_API_KEY=

# ── Correo
SMTP_MODE=file                          # file (escribe .eml en tmp/mails) | smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bolik <web@bolik66.com>"
MAIL_SALES_TO=ventas@bolik66.com
MAIL_SCHOOLS_TO=
MAIL_DISTRIBUTORS_TO=

# ── Medios
MEDIA_DIR=./.media                      # en servidor: D:\bolik\media
MEDIA_PUBLIC_PATH=/media

# ── SEO / IA
INDEXNOW_KEY=                           # 32 caracteres hex; vacío = no se envía

# ── Seguridad
CSP_ENFORCE=false                       # true cuando la CSP esté validada en staging
